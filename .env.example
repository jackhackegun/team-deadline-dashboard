# docker compose up 전에 .env로 복사해 값을 채우세요.
#   cp .env.example .env
#
# 시크릿 두 개는 반드시 직접 생성하세요. 비워두면 컨테이너가 뜨지 않습니다.
#   openssl rand -hex 32

JWT_SECRET=
POSTGRES_PASSWORD=

# 브라우저가 접속하는 주소. 여기 적힌 출처에서만 API 호출이 허용됩니다.
ALLOWED_ORIGINS=http://localhost:8080
WEB_PORT=8080

# 선택 — 비공개 깃허브 레포를 읽거나 요청 한도를 늘릴 때
GITHUB_TOKEN=
GITHUB_SYNC_MINUTES=5

# 선택 — 미설정이면 D-1 마감 알림은 메일 발송 대신 로그만 남깁니다
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM_EMAIL=noreply@team-deadline-dashboard.local
